NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-or-publishable-key

# Optional trusted backend only. Use a server secret/service-role credential.
# Keep this blank until configuring protected workers or signed billing ingest.
SUPABASE_OPERATIONS_KEY=
OPERATIONS_ENDPOINTS_ENABLED=false
OPERATIONS_CRON_SECRET=
# Vercel's native scheduler uses this name; leave blank unless configuring it.
CRON_SECRET=
BILLING_WEBHOOK_ENABLED=false
STRIPE_WEBHOOK_SECRET=
# Server-owned JSON mapping of existing provider price IDs to core/plus plans.
STRIPE_PRICE_PLANS={}
